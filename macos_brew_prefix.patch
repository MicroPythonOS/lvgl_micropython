+        # `brew info` no longer prints the Cellar path (Homebrew 5.1.12) and
+        # no longer quotes the `export LDFLAGS=...` lines (7.0.5), so ask
+        # brew for its prefix. libffi is keg-only: its files are under
+        # <prefix>/opt/libffi. spawn() also returns stderr lines, so keep
+        # only the line that is a directory.
+        ret, out = spawn([[brew_path, '--prefix']], out_to_screen=False)
+        if ret:
+            print(out)
+            sys.exit(ret)
+
+        prefix = [line for line in out.split('\n') if os.path.isdir(line)]
+        if len(prefix) != 1:
+            print(out)
+            raise RuntimeError('Unable to determine the Homebrew prefix')
